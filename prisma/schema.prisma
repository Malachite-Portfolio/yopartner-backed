generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PARTNER
  ADMIN
}

enum CompanionStatus {
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
}

enum CompanionAvailability {
  ONLINE
  BUSY
  OFFLINE
}

enum PartnerApplicationStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum ServiceType {
  CHAT
  AUDIO
  VIDEO
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  PENDING
  ACCEPTED
  LIVE
  DECLINED
  CANCELLED
  ENDED
  EXPIRED
  // Legacy/backward-compatible values
  COMPLETED
  FAILED
  FLAGGED
}

enum TransactionType {
  RECHARGE
  BOOKING
  GIFT
  REFUND
  ADMIN_CREDIT
  LUCKY_WHEEL_REWARD
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum LuckyWheelRewardType {
  FREE_CALL_MINUTES
  TALK_TIME_CREDIT
  FREE_CHAT_MINUTES
  VIDEO_DISCOUNT_PERCENT
}

enum UserRewardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum UserRewardSource {
  LUCKY_WHEEL
  WELCOME_PROFILE
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum PartnerEarningSourceType {
  SESSION
  GIFT
}

enum PartnerEarningStatus {
  PENDING
  AVAILABLE
  PAID
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  NEEDS_REVIEW
}

enum UserModerationStatus {
  ACTIVE
  RESTRICTED
  TEMP_BANNED
  BANNED
}

enum PartnerModerationStatus {
  ACTIVE
  RESTRICTED
  TEMP_BANNED
  BANNED
  HIDDEN
}

enum HomeVisitVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
  SUSPENDED
}

enum ModerationTargetType {
  USER
  PARTNER
  HOME_VISIT
}

model User {
  id             String            @id @default(cuid())
  firebaseUid    String            @unique
  phoneNumber    String            @unique
  name           String?
  email          String?
  age            Int?
  gender         String?
  profileImageUrl String?
  onboardingCompletedAt DateTime?
  role           Role              @default(USER)
  isBlocked      Boolean           @default(false)
  moderationStatus UserModerationStatus @default(ACTIVE)
  moderationReason String?
  moderationExpiresAt DateTime?
  moderatedBy    String?
  moderatedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  companion      Companion?
  partnerApplications PartnerApplication[]
  walletAccount  WalletAccount?
  bookings       Booking[]
  sessions       Session[]         @relation("UserSessions")
  sentMessages   ChatMessage[]     @relation("ChatMessageSender")
  reviews        Review[]          @relation("UserReviews")
  supportTickets SupportTicket[]
  partnerEarnings PartnerEarning[]
  luckyWheelSpins LuckyWheelSpin[]
  rewards        UserReward[]
  pushSubscriptions PushSubscription[]
}

model Companion {
  id                  String                 @id @default(cuid())
  userId              String                 @unique
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  tagline             String?
  city                String?
  category            String?
  languages           String[]
  servicesOffered     ServiceType[]
  chatPrice           Int                    @default(0)
  audioPrice          Int                    @default(0)
  videoPrice          Int                    @default(0)
  rating              Float                  @default(0)
  status              CompanionStatus        @default(UNDER_REVIEW)
  verificationStatus  VerificationStatus     @default(PENDING)
  moderationStatus    PartnerModerationStatus @default(ACTIVE)
  moderationReason    String?
  moderationExpiresAt DateTime?
  moderatedBy         String?
  moderatedAt         DateTime?
  homeVisitVerificationStatus HomeVisitVerificationStatus @default(NOT_SUBMITTED)
  homeVisitVerificationNote   String?
  homeVisitVerifiedAt         DateTime?
  homeVisitVerifiedBy         String?
  isOnline            Boolean                @default(false)
  availability        CompanionAvailability  @default(OFFLINE)
  availabilitySetByAdminAt DateTime?
  profileImageUrl     String?
  profileImageStoragePath String?
  galleryImageUrls    String[]               @default([])
  galleryImageStoragePaths String[]          @default([])
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  bookings            Booking[]
  sessions            Session[]              @relation("CompanionSessions")
  partnerApplications PartnerApplication[]
  payouts             Payout[]
  partnerEarnings     PartnerEarning[]
  reviews             Review[]               @relation("CompanionReviews")
  verificationRecord  VerificationRecord?
  pushSubscriptions   PushSubscription[]
}

model PartnerApplication {
  id                 String                   @id @default(cuid())
  applicantUserId    String
  applicantUser      User                     @relation(fields: [applicantUserId], references: [id], onDelete: Cascade)
  companionId        String?
  companion          Companion?               @relation(fields: [companionId], references: [id], onDelete: SetNull)
  fullName           String
  age                Int
  gender             String
  religion           String?
  bornCity           String?
  nationality        String?
  school             String?
  college            String?
  qualification      String?
  languagesKnown     String[]
  communicationStyle String[]
  hobbies            String[]
  profileTagline     String
  aboutYourself      String
  servicesOffered    ServiceType[]
  chatPrice          Int                      @default(0)
  audioPrice         Int                      @default(0)
  videoPrice         Int                      @default(0)
  homeVisitRequested Boolean                  @default(false)
  homeVisitPrice     Int?
  categories         String[]
  safetyChecklist    String[]
  selfieUploaded     Boolean                  @default(false)
  selfieFileName     String?
  selfieStoragePath  String?
  selfieUrl          String?
  aadhaarFrontUploaded Boolean                @default(false)
  aadhaarFrontFileName String?
  aadhaarFrontStoragePath String?
  aadhaarFrontUrl    String?
  aadhaarBackUploaded Boolean                 @default(false)
  aadhaarBackFileName String?
  aadhaarBackStoragePath String?
  aadhaarBackUrl     String?
  panUploaded        Boolean                  @default(false)
  panFileName        String?
  panStoragePath     String?
  panUrl             String?
  liveVerificationName String?
  liveVerificationAge Int?
  liveVerificationHobbies String?
  liveVideoUploaded Boolean                  @default(false)
  liveVideoFileName String?
  liveVideoStoragePath String?
  liveVerificationSubmittedAt DateTime?
  status             PartnerApplicationStatus @default(UNDER_REVIEW)
  adminNote          String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model ModerationAction {
  id             String               @id @default(cuid())
  targetType     ModerationTargetType
  targetId       String
  actionType     String
  previousStatus String?
  newStatus      String
  reason         String
  expiresAt      DateTime?
  adminId        String
  adminEmail     String?
  createdAt      DateTime             @default(now())

  @@index([targetType, targetId, createdAt])
}

model Booking {
  id             String        @id @default(cuid())
  bookingCode    String        @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId    String
  companion      Companion     @relation(fields: [companionId], references: [id], onDelete: Cascade)
  serviceType    ServiceType
  amount         Int
  status         BookingStatus @default(PENDING)
  scheduledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  session        Session?
  transactions   WalletTransaction[]
}

model Session {
  id               String        @id @default(cuid())
  sessionCode      String        @unique
  bookingId        String?       @unique
  booking          Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId           String
  user             User          @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  companionId      String
  companion        Companion     @relation("CompanionSessions", fields: [companionId], references: [id], onDelete: Cascade)
  serviceType      ServiceType
  status           SessionStatus @default(PENDING)
  acceptedAt       DateTime?
  startedAt        DateTime?
  liveStartedAt    DateTime?
  userMediaReadyAt DateTime?
  partnerMediaReadyAt DateTime?
  endedAt          DateTime?
  endedByUserId    String?
  lastHeartbeatAt  DateTime?
  durationSeconds  Int           @default(0)
  amount           Int           @default(0)
  platformFee      Int           @default(0)
  companionEarning Int           @default(0)
  safetyFlag       Boolean       @default(false)
  safetyNote       String?
  messages         ChatMessage[]
  review           Review?
  partnerEarnings  PartnerEarning[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  senderUserId String
  senderUser   User     @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  body         String
  createdAt    DateTime @default(now())

  @@index([sessionId, createdAt])
}

model WalletAccount {
  id             String              @id @default(cuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  transactions   WalletTransaction[]
}

model WalletTransaction {
  id               String            @id @default(cuid())
  transactionCode  String            @unique
  walletAccountId  String
  walletAccount    WalletAccount     @relation(fields: [walletAccountId], references: [id], onDelete: Cascade)
  bookingId        String?
  booking          Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type             TransactionType
  amount           Int
  status           TransactionStatus @default(PENDING)
  gateway          String?
  referenceId      String?
  reason           String?
  partnerEarnings  PartnerEarning[]
  rewardRedemption UserReward?
  createdAt        DateTime          @default(now())
}

model LuckyWheelSpin {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardType  LuckyWheelRewardType
  rewardValue Int
  rewardLabel String
  rewardIndex Int
  createdAt   DateTime             @default(now())
  expiresAt   DateTime?
  userReward  UserReward?

  @@index([userId, createdAt])
  @@index([rewardType, createdAt])
}

model UserReward {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  LuckyWheelRewardType
  value                 Int
  remainingValue        Int
  status                UserRewardStatus     @default(ACTIVE)
  source                UserRewardSource     @default(LUCKY_WHEEL)
  sourceSpinId          String?              @unique
  sourceSpin            LuckyWheelSpin?      @relation(fields: [sourceSpinId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  expiresAt             DateTime
  redeemedAt            DateTime?
  redemptionReferenceId String?
  walletTransactionId   String?              @unique
  walletTransaction     WalletTransaction?   @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiresAt])
  @@index([type, status, expiresAt])
  @@index([source, createdAt])
  @@index([redemptionReferenceId])
}

model PartnerEarning {
  id                String                   @id @default(cuid())
  companionId       String
  companion         Companion                @relation(fields: [companionId], references: [id], onDelete: Cascade)
  userId            String
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId         String?
  session           Session?                 @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  walletTransactionId String?
  walletTransaction WalletTransaction?       @relation(fields: [walletTransactionId], references: [id], onDelete: SetNull)
  sourceType        PartnerEarningSourceType
  grossAmount       Decimal                  @db.Decimal(12, 2)
  partnerAmount     Decimal                  @db.Decimal(12, 2)
  companyAmount     Decimal                  @db.Decimal(12, 2)
  partnerPercent    Decimal                  @db.Decimal(5, 2)
  companyPercent    Decimal                  @db.Decimal(5, 2)
  status            PartnerEarningStatus     @default(PENDING)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([companionId, createdAt])
  @@index([sourceType, createdAt])
  @@index([status, createdAt])
  @@unique([sourceType, sessionId])
  @@unique([walletTransactionId])
}

model Payout {
  id             String       @id @default(cuid())
  payoutCode     String       @unique
  companionId    String
  companion      Companion    @relation(fields: [companionId], references: [id], onDelete: Cascade)
  amount         Int
  status         PayoutStatus @default(REQUESTED)
  requestedAt    DateTime     @default(now())
  processedAt    DateTime?
  rejectionReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PushSubscription {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companionId String?
  companion   Companion? @relation(fields: [companionId], references: [id], onDelete: SetNull)
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  revokedAt   DateTime?

  @@index([userId, revokedAt])
  @@index([companionId, revokedAt])
}

model Review {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  companionId   String
  companion     Companion   @relation("CompanionReviews", fields: [companionId], references: [id], onDelete: Cascade)
  sessionId     String?     @unique
  session       Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  rating        Int
  comment       String
  isApproved    Boolean     @default(false)
  isHidden      Boolean     @default(false)
  isFlagged     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model SupportTicket {
  id            String      @id @default(cuid())
  ticketCode    String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject       String
  type          String
  priority      String      @default("MEDIUM")
  status        String      @default("OPEN")
  message       String
  internalNotes String[]
  assignedTo    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model VerificationRecord {
  id                  String             @id @default(cuid())
  companionId         String             @unique
  companion           Companion          @relation(fields: [companionId], references: [id], onDelete: Cascade)
  idVerification      VerificationStatus @default(PENDING)
  policeVerification  VerificationStatus @default(PENDING)
  psychometricTest    VerificationStatus @default(PENDING)
  interviewStatus     VerificationStatus @default(PENDING)
  trainingStatus      VerificationStatus @default(PENDING)
  overallStatus       VerificationStatus @default(PENDING)
  updatedAt           DateTime           @updatedAt
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updatedAt   DateTime @updatedAt
}

model MediaItem {
  id          String   @id @default(cuid())
  title       String
  publisher   String?
  type        String
  imageUrl    String?
  linkUrl     String?
  status      String   @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientDiary {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  videoUrl    String?
  status      String   @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
